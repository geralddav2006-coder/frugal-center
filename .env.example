# ─────────────────────────────────────────────────────────────────────────────
# Frugal Center environment variables
# Every integration is optional. Anything left blank runs in a clearly-labelled
# local demo mode for that service — nothing pretends to be real.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (used in emails, QR deep links, Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing secret for local demo auth and unsubscribe links (32+ chars).
# Required in production. Generate: openssl rand -base64 48
AUTH_SECRET=

# Comma-separated emails that are promoted to platform admin on sign-in
ADMIN_EMAILS=

# ── Supabase (auth + Postgres + Storage). All four switch off local demo mode ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase → Connect → Session pooler, port 5432)
DATABASE_URL=
# (On Vercel with the Supabase integration this can stay empty: POSTGRES_URL_NON_POOLING is used.)
# Show "Continue with Google" (enable the Google provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ── Stripe Billing ($29/month subscription). All three required to enable ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── Resend (email notifications) ──
RESEND_API_KEY=
EMAIL_FROM="Frugal Center <deals@yourdomain.com>"

# ── Web push (browser notifications). Generate: npx web-push generate-vapid-keys ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ── Cron (announces scheduled deals when they start) ──
CRON_SECRET=

# ── Local demo only ──
# LOCAL_DB_DIR=.data/pglite
# FC_SIGNUP_LIMIT_PER_HOUR=10   # raise for repeated e2e runs
# FC_FOUNDING_FREE_DAYS=90      # free period for new businesses, no card; 0 turns it off
